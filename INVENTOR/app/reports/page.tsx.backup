const formatMoney = (amount: number) =>
  new Intl.NumberFormat("en-TZ", {
    style: "currency",
    currency: "TZS",
    maximumFractionDigits: 0,
  }).format(amount);

const formatNumber = (number: number) =>
  new Intl.NumberFormat("en-TZ").format(number);

function StatusBadge({ status }: { status: string }) {
  const styles: Record<string, string> = {
    Paid: "bg-emerald-50 text-emerald-700",
    Pending: "bg-amber-50 text-amber-700",
    Overdue: "bg-red-50 text-red-700",
    Available: "bg-emerald-50 text-emerald-700",
    "On Trip": "bg-blue-50 text-blue-700",
    Maintenance: "bg-red-50 text-red-700",
    Planned: "bg-slate-100 text-slate-700",
    "In Progress": "bg-blue-50 text-blue-700",
    Completed: "bg-emerald-50 text-emerald-700",
  };

  return (
    <span
      className={`inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ${
        styles[status] ?? "bg-slate-100 text-slate-600"
      }`}
    >
      {status}
    </span>
  );
}

function MetricCard({
  title,
  value,
  description,
  icon: Icon,
  color,
  trend,
}: {
  title: string;
  value: string;
  description: string;
  icon: typeof Wallet;
  color: string;
  trend?: "up" | "down";
}) {
  return (
    <div className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div className="flex items-start justify-between gap-3">
        <div>
          <p className="text-sm font-medium text-slate-500">{title}</p>
          <h3 className="mt-2 text-2xl font-bold tracking-tight text-slate-900">
            {value}
          </h3>
        </div>

        <div className={`rounded-xl p-3 ${color}`}>
          <Icon size={21} />
        </div>
      </div>

      <div className="mt-4 flex items-center gap-1.5 text-xs text-slate-500">
        {trend === "up" && (
          <TrendingUp size={14} className="text-emerald-600" />
        )}
        {trend === "down" && (
          <TrendingDown size={14} className="text-red-600" />
        )}
        <span>{description}</span>
      </div>
    </div>
  );
}

function SectionHeading({
  title,
  description,
}: {
  title: string;
  description: string;
}) {
  return (
    <div className="mb-5">
      <h2 className="text-lg font-bold text-slate-900">{title}</h2>
      <p className="mt-1 text-sm text-slate-500">{description}</p>
    </div>
  );
}

export default function ReportsPage() {
  const [activeTab, setActiveTab] = useState<ReportTab>("Overview");
  const [search, setSearch] = useState("");
  const [period, setPeriod] = useState("This Month");

  const paidIncome = useMemo(
    () =>
      transactions
        .filter((item) => item.type === "Income" && item.status === "Paid")
        .reduce((sum, item) => sum + item.amount, 0),
    [],
  );

  const paidExpenses = useMemo(
    () =>
      transactions
        .filter((item) => item.type === "Expense" && item.status === "Paid")
        .reduce((sum, item) => sum + item.amount, 0),
    [],
  );

  const totalIncome = useMemo(
    () =>
      transactions
        .filter((item) => item.type === "Income")
        .reduce((sum, item) => sum + item.amount, 0),
    [],
  );

  const totalExpenses = useMemo(
    () =>
      transactions
        .filter((item) => item.type === "Expense")
        .reduce((sum, item) => sum + item.amount, 0),
    [],
  );

  const netCash = paidIncome - paidExpenses;

  const outstanding = transactions
    .filter((item) => item.status !== "Paid")
    .reduce((sum, item) => sum + item.amount, 0);

  const inventoryValue = inventory.reduce(
    (sum, item) => sum + item.quantity * item.unitCost,
    0,
  );

  const lowStockItems = inventory.filter(
    (item) => item.quantity <= item.reorderLevel,
  );

  const availableVehicles = vehicles.filter(
    (vehicle) => vehicle.status === "Available",
  ).length;

  const vehiclesOnTrip = vehicles.filter(
    (vehicle) => vehicle.status === "On Trip",
  ).length;

  const maintenanceVehicles = vehicles.filter(
    (vehicle) => vehicle.status === "Maintenance",
  ).length;

  const filteredTransactions = transactions.filter((item) => {
    const term = search.toLowerCase();

    return (
      item.reference.toLowerCase().includes(term) ||
      item.description.toLowerCase().includes(term) ||
      item.category.toLowerCase().includes(term) ||
      item.type.toLowerCase().includes(term) ||
      item.status.toLowerCase().includes(term)
    );
  });

  const filteredInventory = inventory.filter((item) => {
    const term = search.toLowerCase();

    return (
      item.name.toLowerCase().includes(term) ||
      item.sku.toLowerCase().includes(term) ||
      item.category.toLowerCase().includes(term) ||
      item.warehouse.toLowerCase().includes(term)
    );
  });

  const filteredTrips = trips.filter((trip) => {
    const term = search.toLowerCase();

    return (
      trip.reference.toLowerCase().includes(term) ||
      trip.vehicle.toLowerCase().includes(term) ||
      trip.driver.toLowerCase().includes(term) ||
      trip.origin.toLowerCase().includes(term) ||
      trip.destination.toLowerCase().includes(term) ||
      trip.status.toLowerCase().includes(term)
    );
  });

  const exportCSV = () => {
    let headers: string[] = [];
    let rows: (string | number)[][] = [];
    let filename = "report";

    if (activeTab === "Financial" || activeTab === "Overview") {
      headers = [
        "Date",
        "Reference",
        "Description",
        "Category",
        "Type",
        "Amount TZS",
        "Status",
      ];

      rows = filteredTransactions.map((item) => [
        item.date,
        item.reference,
        item.description,
        item.category,
        item.type,
        item.amount,
        item.status,
      ]);

      filename = "financial-report";
    } else if (activeTab === "Inventory") {
      headers = [
        "SKU",
        "Product",
        "Category",
        "Warehouse",
        "Quantity",
        "Unit",
        "Reorder Level",
        "Unit Cost TZS",
        "Stock Value TZS",
      ];

      rows = filteredInventory.map((item) => [
        item.sku,
        item.name,
        item.category,
        item.warehouse,
        item.quantity,
        item.unit,
        item.reorderLevel,
        item.unitCost,
        item.quantity * item.unitCost,
      ]);

      filename = "inventory-report";
    } else {
      headers = [
        "Reference",
        "Vehicle",
        "Driver",
        "Origin",
        "Destination",
        "Date",
        "Status",
        "Trip Cost TZS",
      ];

      rows = filteredTrips.map((trip) => [
        trip.reference,
        trip.vehicle,
        trip.driver,
        trip.origin,
        trip.destination,
        trip.date,
        trip.status,
        trip.cost,
      ]);

      filename = "trucking-report";
    }

    const escapeCSV = (value: string | number) =>
      `"${String(value).replace(/"/g, '""')}"`;

    const csv = [
      headers.map(escapeCSV).join(","),
      ...rows.map((row) => row.map(escapeCSV).join(",")),
    ].join("\n");

    const blob = new Blob(["\uFEFF" + csv], {
      type: "text/csv;charset=utf-8;",
    });

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");

    link.href = url;
    link.download = `${filename}.csv`;
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);
  };

  const tabs: ReportTab[] = [
    "Overview",
    "Financial",
    "Inventory",
    "Fleet & Trips",
  ];

  const maxMonthlyValue = Math.max(
    ...monthlyPerformance.map((item) =>
      Math.max(item.income, item.expenses),
    ),
  );

  return (
    <main className="min-h-0 w-full min-w-0 bg-slate-50 p-0 text-slate-900">
        <div className="w-full min-w-0 space-y-4">
        {/* Page heading */}
        <div className="mb-4 flex flex-col justify-between gap-4 md:flex-row md:items-center">
          <div>
            <div className="mb-2 flex items-center gap-2 text-sm text-slate-500">
              <BarChart3 size={16} />
              <span>Business Intelligence</span>
              <span>/</span>
              <span>Reports</span>
            </div>

            <h1 className="text-3xl font-bold tracking-tight text-slate-900">
              Reports & Analytics
            </h1>

            <p className="mt-2 max-w-2xl text-sm text-slate-500">
              Monitor financial performance, inventory levels, and transport
              operations from one dashboard.
            </p>
          </div>

          <div className="flex flex-wrap items-center gap-3">
            <div className="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2.5">
              <CalendarDays size={17} className="text-slate-500" />
              <select
                value={period}
                onChange={(event) => setPeriod(event.target.value)}
                className="bg-transparent text-sm font-medium text-slate-700 outline-none"
                aria-label="Report period"
              >
                <option>This Month</option>
                <option>Last 3 Months</option>
                <option>This Year</option>
              </select>
            </div>

            <button
              onClick={exportCSV}
              className="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700"
            >
              <FileDown size={17} />
              Export CSV
            </button>
          </div>
        </div>

        {/* Demo notice */}
        <div className="mb-6 flex items-start gap-3 rounded-xl border border-blue-200 bg-blue-50 p-4">
          <FileText size={19} className="mt-0.5 shrink-0 text-blue-700" />
          <div>
            <p className="text-sm font-semibold text-blue-900">
              Demonstration report data
            </p>
            <p className="mt-1 text-sm text-blue-800">
              These figures are sample records for the interface. The selected
              period is displayed for demonstration; it does not yet filter
              records by date. Connect the reports API to use live business data.
            </p>
          </div>
        </div>

        {/* Tabs */}
        <div className="mb-6 flex gap-2 overflow-x-auto border-b border-slate-200">
          {tabs.map((tab) => (
            <button
              key={tab}
              onClick={() => {
                setActiveTab(tab);
                setSearch("");
              }}
              className={`shrink-0 border-b-2 px-4 py-3 text-sm font-semibold transition ${
                activeTab === tab
                  ? "border-blue-600 text-blue-700"
                  : "border-transparent text-slate-500 hover:text-slate-800"
              }`}
            >
              {tab}
            </button>
          ))}
        </div>

        {/* Overview */}
        {activeTab === "Overview" && (
          <>
            <div className="mb-7 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
              <MetricCard
                title="Total Income"
                value={formatMoney(totalIncome)}
                description="All income records"
                icon={TrendingUp}
                color="bg-emerald-50 text-emerald-700"
                trend="up"
              />

              <MetricCard
                title="Total Expenses"
                value={formatMoney(totalExpenses)}
                description="All expense records"
                icon={TrendingDown}
                color="bg-red-50 text-red-700"
                trend="down"
              />

              <MetricCard
                title="Net Cash Movement"
                value={formatMoney(netCash)}
                description="Paid income minus paid expenses"
                icon={Wallet}
                color="bg-blue-50 text-blue-700"
              />

              <MetricCard
                title="Inventory Value"
                value={formatMoney(inventoryValue)}
                description="Estimated value of current stock"
                icon={Package}
                color="bg-violet-50 text-violet-700"
              />
            </div>

            <div className="mb-7 grid grid-cols-1 gap-6 xl:grid-cols-3">
              {/* Monthly chart */}
              <section className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm xl:col-span-2">
                <div className="mb-6 flex flex-wrap items-start justify-between gap-3">
                  <div>
                    <h2 className="font-bold text-slate-900">
                      Income vs Expenses
                    </h2>
                    <p className="mt-1 text-sm text-slate-500">
                      Illustrative monthly figures
                    </p>
                  </div>

                  <div className="flex gap-4 text-xs font-medium">
                    <span className="flex items-center gap-1.5 text-slate-600">
                      <span className="h-2.5 w-2.5 rounded-sm bg-blue-600" />
                      Income
                    </span>
                    <span className="flex items-center gap-1.5 text-slate-600">
                      <span className="h-2.5 w-2.5 rounded-sm bg-amber-400" />
                      Expenses
                    </span>
                  </div>
                </div>

                <div className="space-y-5">
                  {monthlyPerformance.map((item) => (
                    <div key={item.month}>
                      <div className="mb-2 flex items-center justify-between text-sm">
                        <span className="font-semibold text-slate-700">
                          {item.month} 2026
                        </span>
                        <span className="text-slate-500">
                          Net: {formatMoney(item.income - item.expenses)}
                        </span>
                      </div>

                      <div className="space-y-2">
                        <div className="h-3 overflow-hidden rounded-full bg-slate-100">
                          <div
                            className="h-full rounded-full bg-blue-600"
                            style={{
                              width: `${(item.income / maxMonthlyValue) * 100}%`,
                            }}
                          />
                        </div>

                        <div className="h-3 overflow-hidden rounded-full bg-slate-100">
                          <div
                            className="h-full rounded-full bg-amber-400"
                            style={{
                              width: `${(item.expenses / maxMonthlyValue) * 100}%`,
                            }}
                          />
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </section>

              {/* Operational summary */}
              <section className="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                <h2 className="font-bold text-slate-900">
                  Operational Summary
                </h2>
                <p className="mt-1 text-sm text-slate-500">
                  Current sample records
                </p>

                <div className="mt-5 space-y-4">
                  <div className="flex items-center justify-between rounded-xl bg-slate-50 p-3">
                    <div className="flex items-center gap-3">
                      <div className="rounded-lg bg-blue-100 p-2 text-blue-700">
                        <Truck size={18} />
                      </div>
                      <div>
                        <p className="text-sm font-semibold text-slate-800">
                          Fleet vehicles
                        </p>
                        <p className="text-xs text-slate-500">
                          Registered vehicles
                        </p>
                      </div>
                    </div>
                    <span className="text-lg font-bold text-slate-900">
                      {vehicles.length}
                    </span>
                  </div>

                  <div className="flex items-center justify-between rounded-xl bg-slate-50 p-3">
                    <div className="flex items-center gap-3">
                      <div className="rounded-lg bg-emerald-100 p-2 text-emerald-700">
                        <CheckCircle2 size={18} />
                      </div>
                      <div>
                        <p className="text-sm font-semibold text-slate-800">
                          Available vehicles
                        </p>
                        <p className="text-xs text-slate-500">
                          Ready for assignment
                        </p>
                      </div>
                    </div>
                    <span className="text-lg font-bold text-slate-900">
                      {availableVehicles}
                    </span>
                  </div>

                  <div className="flex items-center justify-between rounded-xl bg-slate-50 p-3">
                    <div className="flex items-center gap-3">
                      <div className="rounded-lg bg-amber-100 p-2 text-amber-700">
                        <Clock size={18} />
                      </div>
                      <div>
                        <p className="text-sm font-semibold text-slate-800">
                          Active trips
                        </p>
                        <p className="text-xs text-slate-500">
                          Currently in progress
                        </p>
                      </div>
                    </div>
                    <span className="text-lg font-bold text-slate-900">
                      {trips.filter((trip) => trip.status === "In Progress").length}
                    </span>
                  </div>

                  <div className="flex items-center justify-between rounded-xl bg-slate-50 p-3">
                    <div className="flex items-center gap-3">
                      <div className="rounded-lg bg-red-100 p-2 text-red-700">
                        <AlertTriangle size={18} />
                      </div>
                      <div>
                        <p className="text-sm font-semibold text-slate-800">
                          Low-stock items
                        </p>
                        <p className="text-xs text-slate-500">
                          At or below reorder level
                        </p>
                      </div>
                    </div>
                    <span className="text-lg font-bold text-slate-900">
                      {lowStockItems.length}
                    </span>
                  </div>
                </div>
              </section>
            </div>

            {/* Recent transactions */}
            <section className="rounded-2xl border border-slate-200 bg-white shadow-sm">
              <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 p-5">
                <div>
                  <h2 className="font-bold text-slate-900">
                    Recent Transactions
                  </h2>
                  <p className="mt-1 text-sm text-slate-500">
                    Latest financial activity
                  </p>
                </div>

                <button
                  onClick={() => setActiveTab("Financial")}
                  className="text-sm font-semibold text-blue-700 hover:text-blue-900"
                >
                  View financial report →
                </button>
              </div>

              <div className="overflow-x-auto">
                <table className="w-full min-w-[760px] text-left text-sm">
                  <thead className="bg-slate-50 text-xs uppercase text-slate-500">
                    <tr>
                      <th className="px-5 py-3 font-semibold">Reference</th>
                      <th className="px-5 py-3 font-semibold">Description</th>
                      <th className="px-5 py-3 font-semibold">Date</th>
                      <th className="px-5 py-3 font-semibold">Type</th>
                      <th className="px-5 py-3 text-right font-semibold">
                        Amount
                      </th>
                      <th className="px-5 py-3 font-semibold">Status</th>
                    </tr>
                  </thead>

                  <tbody className="divide-y divide-slate-100">
                    {transactions.slice(0, 5).map((item) => (
                      <tr key={item.id} className="hover:bg-slate-50">
                        <td className="px-5 py-4 font-semibold text-slate-800">
                          {item.reference}
                        </td>
                        <td className="px-5 py-4 text-slate-600">
                          {item.description}
                        </td>
                        <td className="px-5 py-4 text-slate-500">
                          {item.date}
                        </td>
                        <td className="px-5 py-4">
                          <span
                            className={
                              item.type === "Income"
                                ? "font-medium text-emerald-700"
                                : "font-medium text-red-700"
                            }
                          >
                            {item.type}
                          </span>
                        </td>
                        <td className="px-5 py-4 text-right font-semibold text-slate-800">
                          {formatMoney(item.amount)}
                        </td>
                        <td className="px-5 py-4">
                          <StatusBadge status={item.status} />
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          </>
        )}

        {/* Financial report */}
        {activeTab === "Financial" && (
          <>
            <div className="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
              <MetricCard
                title="Total Income"
                value={formatMoney(totalIncome)}
                description="Paid and unpaid income"
                icon={TrendingUp}
                color="bg-emerald-50 text-emerald-700"
              />

              <MetricCard
                title="Total Expenses"
                value={formatMoney(totalExpenses)}
                description="Paid and unpaid expenses"
                icon={TrendingDown}
                color="bg-red-50 text-red-700"
              />

              <MetricCard
                title="Net Cash Movement"
                value={formatMoney(netCash)}
                description="Based on paid transactions"
                icon={Wallet}
                color="bg-blue-50 text-blue-700"
              />

              <MetricCard
                title="Outstanding Payments"
                value={formatMoney(outstanding)}
                description="Pending and overdue records"
                icon={Clock}
                color="bg-amber-50 text-amber-700"
              />
            </div>

            <div className="mb-6 grid grid-cols-1 gap-4 md:grid-cols-3">
              <div className="rounded-xl border border-slate-200 bg-white p-5">
                <p className="text-sm text-slate-500">Paid income</p>
                <p className="mt-2 text-xl font-bold text-emerald-700">
                  {formatMoney(paidIncome)}
                </p>
              </div>
              <div className="rounded-xl border border-slate-200 bg-white p-5">
                <p className="text-sm text-slate-500">Paid expenses</p>
                <p className="mt-2 text-xl font-bold text-red-700">
                  {formatMoney(paidExpenses)}
                </p>
              </div>
              <div className="rounded-xl border border-slate-200 bg-white p-5">
                <p className="text-sm text-slate-500">Unpaid expenses</p>
                <p className="mt-2 text-xl font-bold text-amber-700">
                  {formatMoney(
                    transactions
                      .filter(
                        (item) =>
                          item.type === "Expense" && item.status !== "Paid",
                      )
                      .reduce((sum, item) => sum + item.amount, 0),
                  )}
                </p>
              </div>
            </div>

            <section className="rounded-2xl border border-slate-200 bg-white shadow-sm">
              <div className="flex flex-col justify-between gap-4 border-b border-slate-100 p-5 md:flex-row md:items-center">
                <div>
                  <h2 className="font-bold text-slate-900">
                    Financial Transactions
                  </h2>
                  <p className="mt-1 text-sm text-slate-500">
                    Income, expenses, and payment status
                  </p>
                </div>

                <div className="relative w-full md:max-w-xs">
                  <Search
                    size={17}
                    className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
                  />
                  <input
                    value={search}
                    onChange={(event) => setSearch(event.target.value)}
                    placeholder="Search transactions..."
                    className="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-3 text-sm outline-none focus:border-blue-500"
                  />
                </div>
              </div>

              <div className="overflow-x-auto">
                <table className="w-full min-w-[800px] text-left text-sm">
                  <thead className="bg-slate-50 text-xs uppercase text-slate-500">
                    <tr>
                      <th className="px-5 py-3">Reference</th>
                      <th className="px-5 py-3">Description</th>
                      <th className="px-5 py-3">Category</th>
                      <th className="px-5 py-3">Date</th>
                      <th className="px-5 py-3">Type</th>
                      <th className="px-5 py-3 text-right">Amount</th>
                      <th className="px-5 py-3">Status</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100">
                    {filteredTransactions.map((item) => (
                      <tr key={item.id} className="hover:bg-slate-50">
                        <td className="px-5 py-4 font-semibold text-slate-800">
                          {item.reference}
                        </td>
                        <td className="px-5 py-4">{item.description}</td>
                        <td className="px-5 py-4 text-slate-500">
                          {item.category}
                        </td>
                        <td className="px-5 py-4 text-slate-500">
                          {item.date}
                        </td>
                        <td className="px-5 py-4">{item.type}</td>
                        <td className="px-5 py-4 text-right font-semibold">
                          {formatMoney(item.amount)}
                        </td>
                        <td className="px-5 py-4">
                          <StatusBadge status={item.status} />
                        </td>
                      </tr>
                    ))}

                    {filteredTransactions.length === 0 && (
                      <tr>
                        <td
                          colSpan={7}
                          className="px-5 py-10 text-center text-slate-500"
                        >
                          No transactions match your search.
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </section>
          </>
        )}

        {/* Inventory report */}
        {activeTab === "Inventory" && (
          <>
            <div className="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
              <MetricCard
                title="Product Types"
                value={formatNumber(inventory.length)}
                description="Different stock items"
                icon={Package}
                color="bg-blue-50 text-blue-700"
              />

              <MetricCard
                title="Estimated Stock Value"
                value={formatMoney(inventoryValue)}
                description="Quantity × unit cost"
                icon={Wallet}
                color="bg-violet-50 text-violet-700"
              />

              <MetricCard
                title="Low-Stock Items"
                value={formatNumber(lowStockItems.length)}
                description="At or below reorder level"
                icon={AlertTriangle}
                color="bg-amber-50 text-amber-700"
              />
            </div>

            <section className="mb-6 rounded-2xl border border-amber-200 bg-amber-50 p-5">
              <div className="mb-4 flex items-center gap-2">
                <AlertTriangle size={19} className="text-amber-700" />
                <h2 className="font-bold text-amber-900">
                  Reorder Alerts
                </h2>
              </div>

              <div className="grid grid-cols-1 gap-3 md:grid-cols-3">
                {lowStockItems.map((item) => (
                  <div
                    key={item.id}
                    className="rounded-xl border border-amber-200 bg-white p-4"
                  >
                    <div className="flex items-start justify-between gap-2">
                      <p className="font-semibold text-slate-800">
                        {item.name}
                      </p>
                      {item.quantity === 0 && (
                        <span className="rounded-full bg-red-100 px-2 py-1 text-xs font-semibold text-red-700">
                          Out of stock
                        </span>
                      )}
                    </div>
                    <p className="mt-2 text-sm text-slate-500">
                      SKU: {item.sku}
                    </p>
                    <p className="mt-3 text-sm">
                      Available:{" "}
                      <span className="font-bold text-red-700">
                        {item.quantity} {item.unit}
                      </span>
                    </p>
                    <p className="mt-1 text-sm text-slate-500">
                      Reorder level: {item.reorderLevel} {item.unit}
                    </p>
                  </div>
                ))}
              </div>
            </section>

            <section className="rounded-2xl border border-slate-200 bg-white shadow-sm">
              <div className="flex flex-col justify-between gap-4 border-b border-slate-100 p-5 md:flex-row md:items-center">
                <div>
                  <h2 className="font-bold text-slate-900">
                    Inventory Valuation
                  </h2>
                  <p className="mt-1 text-sm text-slate-500">
                    Stock quantities and estimated values
                  </p>
                </div>

                <div className="relative w-full md:max-w-xs">
                  <Search
                    size={17}
                    className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
                  />
                  <input
                    value={search}
                    onChange={(event) => setSearch(event.target.value)}
                    placeholder="Search inventory..."
                    className="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-3 text-sm outline-none focus:border-blue-500"
                  />
                </div>
              </div>

              <div className="overflow-x-auto">
                <table className="w-full min-w-[850px] text-left text-sm">
                  <thead className="bg-slate-50 text-xs uppercase text-slate-500">
                    <tr>
                      <th className="px-5 py-3">SKU</th>
                      <th className="px-5 py-3">Product</th>
                      <th className="px-5 py-3">Warehouse</th>
                      <th className="px-5 py-3 text-right">Quantity</th>
                      <th className="px-5 py-3 text-right">Unit Cost</th>
                      <th className="px-5 py-3 text-right">Stock Value</th>
                      <th className="px-5 py-3">Stock Status</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100">
                    {filteredInventory.map((item) => {
                      const low = item.quantity <= item.reorderLevel;

                      return (
                        <tr key={item.id} className="hover:bg-slate-50">
                          <td className="px-5 py-4 font-semibold text-slate-800">
                            {item.sku}
                          </td>
                          <td className="px-5 py-4">
                            <p className="font-medium text-slate-800">
                              {item.name}
                            </p>
                            <p className="mt-1 text-xs text-slate-500">
                              {item.category}
                            </p>
                          </td>
                          <td className="px-5 py-4 text-slate-600">
                            {item.warehouse}
                          </td>
                          <td className="px-5 py-4 text-right">
                            {item.quantity} {item.unit}
                          </td>
                          <td className="px-5 py-4 text-right">
                            {formatMoney(item.unitCost)}
                          </td>
                          <td className="px-5 py-4 text-right font-semibold">
                            {formatMoney(item.quantity * item.unitCost)}
                          </td>
                          <td className="px-5 py-4">
                            <StatusBadge
                              status={
                                item.quantity === 0
                                  ? "Overdue"
                                  : low
                                    ? "Pending"
                                    : "Paid"
                              }
                            />
                          </td>
                        </tr>
                      );
                    })}

                    {filteredInventory.length === 0 && (
                      <tr>
                        <td
                          colSpan={7}
                          className="px-5 py-10 text-center text-slate-500"
                        >
                          No inventory items match your search.
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </section>
          </>
        )}

        {/* Fleet and trips */}
        {activeTab === "Fleet & Trips" && (
          <>
            <div className="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
              <MetricCard
                title="Total Vehicles"
                value={formatNumber(vehicles.length)}
                description="Registered fleet"
                icon={Truck}
                color="bg-blue-50 text-blue-700"
              />

              <MetricCard
                title="Available"
                value={formatNumber(availableVehicles)}
                description="Ready for assignments"
                icon={CheckCircle2}
                color="bg-emerald-50 text-emerald-700"
              />

              <MetricCard
                title="On Trip"
                value={formatNumber(vehiclesOnTrip)}
                description="Currently assigned"
                icon={ArrowUpRight}
                color="bg-amber-50 text-amber-700"
              />

              <MetricCard
                title="Maintenance"
                value={formatNumber(maintenanceVehicles)}
                description="Unavailable vehicles"
                icon={AlertTriangle}
                color="bg-red-50 text-red-700"
              />
            </div>

            <section className="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
              <SectionHeading
                title="Fleet Availability"
                description="Vehicle status across the sample fleet"
              />

              <div className="space-y-5">
                {vehicles.map((vehicle) => (
                  <div key={vehicle.id}>
                    <div className="mb-2 flex flex-wrap items-center justify-between gap-2">
                      <div>
                        <p className="font-semibold text-slate-800">
                          {vehicle.registration} · {vehicle.model}
                        </p>
                        <p className="mt-1 text-xs text-slate-500">
                          Driver: {vehicle.driver} · Capacity:{" "}
                          {vehicle.capacity} tonnes
                        </p>
                      </div>
                      <StatusBadge status={vehicle.status} />
                    </div>

                    <div className="h-2 overflow-hidden rounded-full bg-slate-100">
                      <div
                        className={`h-full rounded-full ${
                          vehicle.status === "Available"
                            ? "w-full bg-emerald-500"
                            : vehicle.status === "On Trip"
                              ? "w-2/3 bg-blue-500"
                              : "w-1/4 bg-red-500"
                        }`}
                      />
                    </div>
                  </div>
                ))}
              </div>
            </section>

            <section className="rounded-2xl border border-slate-200 bg-white shadow-sm">
              <div className="flex flex-col justify-between gap-4 border-b border-slate-100 p-5 md:flex-row md:items-center">
                <div>
                  <h2 className="font-bold text-slate-900">
                    Trip Performance
                  </h2>
                  <p className="mt-1 text-sm text-slate-500">
                    Trip destinations, statuses, and costs
                  </p>
                </div>

                <div className="relative w-full md:max-w-xs">
                  <Search
                    size={17}
                    className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
                  />
                  <input
                    value={search}
                    onChange={(event) => setSearch(event.target.value)}
                    placeholder="Search trips..."
                    className="w-full rounded-xl border border-slate-200 py-2.5 pl-10 pr-3 text-sm outline-none focus:border-blue-500"
                  />
                </div>
              </div>

              <div className="overflow-x-auto">
                <table className="w-full min-w-[850px] text-left text-sm">
                  <thead className="bg-slate-50 text-xs uppercase text-slate-500">
                    <tr>
                      <th className="px-5 py-3">Trip</th>
                      <th className="px-5 py-3">Vehicle / Driver</th>
                      <th className="px-5 py-3">Route</th>
                      <th className="px-5 py-3">Date</th>
                      <th className="px-5 py-3">Status</th>
                      <th className="px-5 py-3 text-right">Trip Cost</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100">
                    {filteredTrips.map((trip) => (
                      <tr key={trip.id} className="hover:bg-slate-50">
                        <td className="px-5 py-4 font-semibold text-slate-800">
                          {trip.reference}
                        </td>
                        <td className="px-5 py-4">
                          <p className="font-medium text-slate-800">
                            {trip.vehicle}
                          </p>
                          <p className="mt-1 text-xs text-slate-500">
                            {trip.driver}
                          </p>
                        </td>
                        <td className="px-5 py-4">
                          <p className="text-slate-800">{trip.origin}</p>
                          <p className="mt-1 text-xs text-slate-500">
                            to {trip.destination}
                          </p>
                        </td>
                        <td className="px-5 py-4 text-slate-500">
                          {trip.date}
                        </td>
                        <td className="px-5 py-4">
                          <StatusBadge status={trip.status} />
                        </td>
                        <td className="px-5 py-4 text-right font-semibold">
                          {formatMoney(trip.cost)}
                        </td>
                      </tr>
                    ))}

                    {filteredTrips.length === 0 && (
                      <tr>
                        <td
                          colSpan={6}
                          className="px-5 py-10 text-center text-slate-500"
                        >
                          No trips match your search.
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </section>
          </>
        )}

        {/* Footer */}
        <div className="mt-8 flex flex-col justify-between gap-2 border-t border-slate-200 pt-5 text-xs text-slate-500 sm:flex-row">
          <p>Integrated Finance, Procurement, Inventory & Trucking System</p>
          <p>Reports & Analytics · Demonstration Mode</p>
        </div>
      </div>
    </main>
  );
}
