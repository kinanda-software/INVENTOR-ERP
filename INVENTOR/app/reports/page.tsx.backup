
"use client";

import { useMemo, useState } from "react";
import {
  BarChart3,
  TrendingUp,
  TrendingDown,
  Package,
  Truck,
  Wallet,
  FileDown,
  Search,
  CalendarDays,
  CheckCircle2,
  AlertTriangle,
  Clock,
  ArrowUpRight,
  ArrowDownRight,
  FileText,
} from "lucide-react";

type ReportTab = "Overview" | "Financial" | "Inventory" | "Fleet & Trips";

type Transaction = {
  id: number;
  date: string;
  reference: string;
  description: string;
  category: string;
  type: "Income" | "Expense";
  amount: number;
  status: "Paid" | "Pending" | "Overdue";
};

type InventoryItem = {
  id: number;
  sku: string;
  name: string;
  category: string;
  warehouse: string;
  quantity: number;
  reorderLevel: number;
  unit: string;
  unitCost: number;
};

type Vehicle = {
  id: number;
  registration: string;
  model: string;
  driver: string;
  capacity: number;
  status: "Available" | "On Trip" | "Maintenance";
};

type Trip = {
  id: number;
  reference: string;
  vehicle: string;
  driver: string;
  origin: string;
  destination: string;
  date: string;
  status: "Planned" | "In Progress" | "Completed";
  cost: number;
};

